# ===========================================
# MicroSeem Environment Configuration
# ===========================================
# Copy this file to .env and fill in your values

# ----- Server -----
PORT=8080
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174

# ----- PostgreSQL -----
# For local development:
DATABASE_URL=host=localhost user=o365_user password=o365_password dbname=o365_monitor port=5432 sslmode=disable
# For DigitalOcean managed database (auto-injected):
# DATABASE_URL=${db.DATABASE_URL}

# ----- Clerk Authentication -----
# Get these from your Clerk dashboard: https://dashboard.clerk.com
CLERK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
CLERK_FRONTEND_API=https://your-app.clerk.accounts.dev

# ----- Kafka -----
# For local development:
KAFKA_BROKERS=localhost:9092
# For production (Aiven, Confluent, etc.):
# KAFKA_BROKERS=kafka-xxx.aivencloud.com:12345

# ----- Elasticsearch -----
# For local development:
ELASTICSEARCH_URL=http://localhost:9200
# For production (Elastic Cloud, Aiven, etc.):
# ELASTICSEARCH_URL=https://user:pass@elasticsearch-xxx.es.us-east-1.aws.elastic.cloud:9243

# ----- GeoIP Database -----
# MaxMind GeoLite2 database path
GEOIP_DB_PATH=GeoLite2-City.mmdb
