# ===========================================
# MicroSeem Configuration
# ===========================================
# Copy this file to .env and fill in your values
# cp .env.example .env

# ===========================================
# REQUIRED: JWT Authentication Secret
# ===========================================
# Generate a secure random key (at least 32 characters)
# You can use: openssl rand -base64 32
JWT_SECRET=your_secure_jwt_secret_key_here_change_me

# ===========================================
# Database Configuration
# ===========================================
POSTGRES_USER=microseem
POSTGRES_PASSWORD=change_me_to_a_secure_password
POSTGRES_DB=microseem
# POSTGRES_PORT=5432  # Uncomment to change default

# ===========================================
# Service Ports
# ===========================================
# Frontend web UI port
FRONTEND_PORT=3000

# Backend API port
API_PORT=8080

# Elasticsearch port
ES_PORT=9200

# Kibana analytics port
KIBANA_PORT=5601

# Kafka port (internal use)
# KAFKA_PORT=9092

# ===========================================
# URLs (adjust for your domain)
# ===========================================
# API URL as seen by the frontend (include /api)
VITE_API_URL=http://localhost:8080/api

# Kibana URL for embedded analytics
VITE_KIBANA_URL=http://localhost:5601

# CORS allowed origins (comma-separated)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# ===========================================
# Performance Tuning
# ===========================================
# Elasticsearch heap size (min 512m recommended)
ES_HEAP_SIZE=1g

# Kafka log retention (hours)
KAFKA_RETENTION_HOURS=168

# ===========================================
# Optional: GeoIP Database
# ===========================================
# Download GeoLite2-City.mmdb from MaxMind
# https://dev.maxmind.com/geoip/geolite2-free-geolocation-data
# Place in project root directory

# ===========================================
# Production Settings
# ===========================================
# For production, also consider:
# - Setting up SSL/TLS with a reverse proxy (nginx, traefik, caddy)
# - Using stronger passwords
# - Restricting ports to localhost (127.0.0.1:port:port)
# - Setting up proper backups for postgres_data and elasticsearch_data volumes
