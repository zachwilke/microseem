# ===========================================
# MicroSeem Frontend Environment Configuration
# ===========================================
# Copy this file to .env and fill in your values

# ----- Clerk Authentication -----
# Get this from your Clerk dashboard: https://dashboard.clerk.com
VITE_CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ----- API URL -----
# For local development (leave empty to use default localhost:8080):
# VITE_API_URL=
# For production:
VITE_API_URL=https://api.your-domain.com/api

# ----- Kibana URL (optional) -----
# For embedded analytics dashboard
VITE_KIBANA_URL=http://localhost:5601
